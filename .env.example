# Copy this file to .env and fill in. .env is git-ignored.

# From app.gnani.ai/voice -> API keys
GNANI_API_KEY=

# Any OpenAI-compatible chat API. Pick one:
#   Gemini (free tier): LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Groq (free tier):   LLM_BASE_URL=https://api.groq.com/openai/v1
# Check the provider's docs for the current model name.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: a second model tried once when LLM_MODEL is overloaded (HTTP 429/500/503) or times out.
LLM_FALLBACK_MODEL=
